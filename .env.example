# Base URL de la Minimal Ecommerce API (incluye /api, sin barra final).
# Rutas de negocio: ${NEXT_PUBLIC_API_URL}/v1/...
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Opcional: OpenAPI JSON para regenerar tipos (`pnpm api:types`)
# NEXT_PUBLIC_API_DOCS_JSON=https://minimalshopapi.up.railway.app/docs-json

# Origen público del storefront (sin barra final): canonical, Open Graph y sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
